# 3 Chillies — environment variables
# Copy this file to ".env.local" and fill in your Supabase project details.
# Leave blank to run in offline demo mode (menu from code, cart/admin in browser).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin gate (client-side demo credentials). Change these before going live.
NEXT_PUBLIC_ADMIN_USER=admin
NEXT_PUBLIC_ADMIN_PASS=3chillies
